APP_NAME=Klassio
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
# Dominio público sin esquema, usado por las labels de Traefik en docker-compose.yml
APP_DOMAIN=your-domain.example
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=klassio
DB_USERNAME=klassio
DB_PASSWORD=replace-with-a-unique-database-password
DB_ROOT_PASSWORD=replace-with-a-unique-root-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=klassio
# IMPORTANTE: key y secret SOLO alfanuméricos (hex/letras/números).
# El key va en la ruta del WebSocket (/app/{key}): "/" o "+" la rompen (404).
# Genera con: openssl rand -hex 16
REVERB_APP_KEY=replace-with-a-unique-reverb-key
REVERB_APP_SECRET=replace-with-a-unique-reverb-secret
# Use the public TLS endpoint here if Nginx proxies /apps/ and /app/.
REVERB_BACKEND_HOST=your-domain.example
REVERB_HOST=your-domain.example
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_ENABLED=true
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=2001

MAIL_MAILER=log
